package com.example.demo.service;

import org.springframework.stereotype.Service;
import java.util.Arrays;
import java.util.List;

@Service
public class QuestionFilterService {

    private final List<String> javaKeywords = Arrays.asList(
            "classe", "objet", "méthode", "constructeur", "JVM", "ArrayList",
            "interface", "String", "package", "surcharge", "héritage", "equals", "HashMap"
    );

    public boolean isJavaQuestion(String question) {
        String questionLower = question.toLowerCase();
        if (questionLower.contains("java")) {
            return true;
        }

        for (String keyword : javaKeywords) {
            if (questionLower.contains(keyword.toLowerCase())) {
                return true;
            }
        }

        return false;
    }
}
